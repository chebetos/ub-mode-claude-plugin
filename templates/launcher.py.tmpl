import os
import sys
from pathlib import Path
from runpy import run_module

# The tool shells out to the project's `python3`; keep this script's env from shadowing it.
env_bin = os.path.normpath(str(Path(sys.executable).parent))
os.environ["PATH"] = os.pathsep.join(
    entry
    for entry in os.environ.get("PATH", "").split(os.pathsep)
    if os.path.normpath(entry) != env_bin
)
os.environ.pop("VIRTUAL_ENV", None)

sys.path.insert(0, str(Path(__file__).resolve().parent / "vendor"))
run_module("{{tool}}", run_name="__main__", alter_sys=True)
